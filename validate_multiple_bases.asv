pi_b = baseQR.permutationMatrix(:, 1:baseQR.numberOfBaseParameters)' * sol.pi_s;
isaac_b = baseQR.permutationMatrix(:, 1:baseQR.numberOfBaseParameters)' * usd_params.pi_standard';

% param_sets = create_param_sets( ...
%     isaac_b, sol.pi_fr, [0.1, 0.01, 0.01, 0.05, 1, 1], 'isaac dynamic', ...
%     sol.pi_b, sol.pi_fr, [1, 1, 1, 1, 1, 1], 'base', ...
%     pi_b, sol.pi_fr, [1, 1, 1, 1, 1, 1], 'dynamic');
scales=[200, 1500, 300, 25, 2, 0.005];
param_sets = create_param_sets( ...
    isaac_b, sol.pi_fr, drive_gains'/diag(scales), 'isaac dynamic', ...
    sol.pi_b, sol.pi_fr, drive_gains', 'base', ...
    pi_b, sol.pi_fr, drive_gains', 'dynamic');

rre = plot_multi_params(path_to_val_data, idxs, baseQR, drive_gains, param_sets);